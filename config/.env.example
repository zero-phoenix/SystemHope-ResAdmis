# ResAdmi - Configuración de Variables de Entorno
# Copia este archivo a .env y reemplaza con tus valores

# PATHS - Rutas del Sistema
TEMPLATE_PATH=D:/BETTER CALL DAVID/ResAdmi/templates
OUTPUT_PATH=D:/BETTER CALL DAVID/ResAdmi/expedientes
SCRATCH_PATH=D:/BETTER CALL DAVID/ResAdmi/scratch

# WORD - Configuración de Microsoft Word
WORD_TIMEOUT=30
WORD_VISIBLE=false

# LOGGING - Configuración de logs
LOG_LEVEL=INFO
LOG_FILE=logs/resadmi.log

# VALIDACION - Reglas estrictas
STRICT_VALIDATION=true
AUTO_CLEAN_FORMATTING=true

# METADATA - Información del usuario
USER_NAME=Tu Nombre
USER_EMAIL=tu.email@example.com
USER_INSTITUTION=INDECOPI - CC1

# DATABASE - Si se implementa en futuro
DB_TYPE=sqlite
DB_PATH=./data/resadmi.db
